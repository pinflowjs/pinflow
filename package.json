{
  "name": "pinflowjs",
  "version": "1.0.1",
  "description": "Add a comment layer to any web page, then hand the export to your coding agent. One script tag, zero dependencies, and reviewers don't install anything.",
  "keywords": [
    "annotation",
    "feedback",
    "comments",
    "prototype",
    "review",
    "pin",
    "markdown",
    "claude",
    "cursor",
    "vibe-coding"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pinflowjs/pinflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinflowjs/pinflow.git"
  },
  "bugs": {
    "url": "https://github.com/pinflowjs/pinflow/issues"
  },
  "author": "Pinflow contributors",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "dist/pinflow.iife.js",
  "jsdelivr": "dist/pinflow.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./voice": {
      "types": "./dist/voice.d.ts",
      "import": "./dist/voice.js",
      "require": "./dist/voice.cjs"
    },
    "./package.json": "./package.json",
    "./verification": {
      "types": "./dist/verification.d.ts",
      "import": "./dist/verification.js",
      "require": "./dist/verification.cjs"
    },
    "./instrumentation": {
      "types": "./dist/instrumentation.d.ts",
      "import": "./dist/instrumentation.js",
      "require": "./dist/instrumentation.cjs"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js",
      "require": "./dist/capture.cjs"
    },
    "./handoff": {
      "types": "./dist/handoff.d.ts",
      "import": "./dist/handoff.js",
      "require": "./dist/handoff.cjs"
    }
  },
  "files": [
    "dist",
    "agent",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "wiki:check": "node scripts/wiki-check.mjs",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build && pnpm test:coverage && pnpm size"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@playwright/test": "^1.49.0",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "18",
    "@vitest/coverage-v8": "^2.1.5",
    "happy-dom": "^20.11.2",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "18",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "vue": "^3.5.12"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "size-limit": [
    {
      "name": "core (IIFE, gz)",
      "path": "dist/pinflow.iife.js",
      "limit": "31.81 KB",
      "gzip": true,
      "ignore": [
        "pinflowjs/voice"
      ]
    },
    {
      "name": "core (ESM, gz)",
      "path": "dist/index.js",
      "limit": "31.64 KB",
      "gzip": true,
      "ignore": [
        "pinflowjs/voice"
      ]
    },
    {
      "name": "voice (ESM, gz)",
      "path": "dist/voice.js",
      "limit": "4.45 KB",
      "gzip": true
    },
    {
      "name": "react wrapper (ESM, gz)",
      "path": "dist/react.js",
      "limit": "0.51 KB",
      "gzip": true,
      "ignore": [
        "pinflowjs",
        "react"
      ]
    },
    {
      "name": "vue wrapper (ESM, gz)",
      "path": "dist/vue.js",
      "limit": "0.69 KB",
      "gzip": true,
      "ignore": [
        "pinflowjs",
        "vue"
      ]
    },
    {
      "name": "capture (ESM, gz)",
      "path": "dist/capture.js",
      "limit": "23.81 KB",
      "gzip": true,
      "ignore": [
        "pinflowjs/voice"
      ]
    },
    {
      "name": "handoff (ESM, gz)",
      "path": "dist/handoff.js",
      "limit": "6.11 KB",
      "gzip": true
    }
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
